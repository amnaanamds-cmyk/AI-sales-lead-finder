# Public URL of the app, used for payment return URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used to record payments and grant plans/credits.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Places API (New). Server-only.
GOOGLE_PLACES_API_KEY=your-places-api-key

# Claude API (scoring + pitches). Server-only.
ANTHROPIC_API_KEY=your-anthropic-key
# Optional model overrides (defaults: claude-haiku-4-5 for scoring, claude-opus-5 for pitches)
# ANTHROPIC_SCORING_MODEL=
# ANTHROPIC_PITCH_MODEL=

# JazzCash hosted checkout (from your JazzCash merchant portal). Server-only.
JAZZCASH_ENV=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
